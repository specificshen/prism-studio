{
  "name": "prism-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "dev": "pnpm --filter @prism/editor dev",
    "sample": "node tools/make-sample-scene.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
